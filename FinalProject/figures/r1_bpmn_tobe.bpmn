<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_r1_tobe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:collaboration id="Collab_r1_tobe">
    <bpmn:participant id="P_cust" name="Khách dùng ứng dụng" processRef="Proc_cust" />
    <bpmn:participant id="P_store" name="Cửa hàng xăng dầu (TO-BE)" processRef="Proc_store" />
    <bpmn:messageFlow id="m0" name="đơn nháp" sourceRef="c1" targetRef="P_store" />
    <bpmn:messageFlow id="m1m" sourceRef="s1" targetRef="c3" />
    <bpmn:messageFlow id="m2" sourceRef="c4" targetRef="s2" />
    <bpmn:messageFlow id="m3" sourceRef="s3x" targetRef="c5a" />
    <bpmn:messageFlow id="m4" sourceRef="a6" targetRef="c5b" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_cust" isExecutable="false">
    <bpmn:startEvent id="c0" name="Cần đổ xăng">
      <bpmn:outgoing>cf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c1" name="Tạo đơn trên ứng dụng: loại xăng, số tiền">
      <bpmn:incoming>cf1</bpmn:incoming>
      <bpmn:outgoing>cf2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c2" name="Hàng chờ quá dài?">
      <bpmn:incoming>cf2</bpmn:incoming>
      <bpmn:outgoing>cf3</bpmn:outgoing>
      <bpmn:outgoing>cf4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c2e" name="Bỏ đi, đơn nháp tự hủy">
      <bpmn:incoming>cf3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c3" name="Được mời vào trụ">
      <bpmn:incoming>cf4</bpmn:incoming>
      <bpmn:outgoing>cf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c4" name="Đưa mã đơn cho nhân viên">
      <bpmn:incoming>cf5</bpmn:incoming>
      <bpmn:outgoing>cf6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="c5">
      <bpmn:incoming>cf6</bpmn:incoming>
      <bpmn:outgoing>cf7</bpmn:outgoing>
      <bpmn:outgoing>cf9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c5a" name="Được báo không bơm được">
      <bpmn:incoming>cf7</bpmn:incoming>
      <bpmn:outgoing>cf8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c5a" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c5e" name="Rời trụ, không bị trừ tiền">
      <bpmn:incoming>cf8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c5b" name="Nhận HĐĐT, tiền hoàn nếu có">
      <bpmn:incoming>cf9</bpmn:incoming>
      <bpmn:outgoing>cf10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c5b" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c6" name="Rời trụ (không thanh toán tại trụ)">
      <bpmn:incoming>cf10</bpmn:incoming>
      <bpmn:outgoing>cf11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c7" name="Đã đổ xăng">
      <bpmn:incoming>cf11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="cf1" sourceRef="c0" targetRef="c1" />
    <bpmn:sequenceFlow id="cf2" sourceRef="c1" targetRef="c2" />
    <bpmn:sequenceFlow id="cf3" name="Có" sourceRef="c2" targetRef="c2e" />
    <bpmn:sequenceFlow id="cf4" name="Không" sourceRef="c2" targetRef="c3" />
    <bpmn:sequenceFlow id="cf5" sourceRef="c3" targetRef="c4" />
    <bpmn:sequenceFlow id="cf6" sourceRef="c4" targetRef="c5" />
    <bpmn:sequenceFlow id="cf7" sourceRef="c5" targetRef="c5a" />
    <bpmn:sequenceFlow id="cf8" sourceRef="c5a" targetRef="c5e" />
    <bpmn:sequenceFlow id="cf9" sourceRef="c5" targetRef="c5b" />
    <bpmn:sequenceFlow id="cf10" sourceRef="c5b" targetRef="c6" />
    <bpmn:sequenceFlow id="cf11" sourceRef="c6" targetRef="c7" />
    <bpmn:textAnnotation id="t1">
      <bpmn:text>Đổi 1 · chuẩn bị đơn trước khi vào trụ; chưa trừ tiền khi còn chờ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_t1" associationDirection="None" sourceRef="c1" targetRef="t1" />
  </bpmn:process>
  <bpmn:process id="Proc_store" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_store">
      <bpmn:lane id="L_att" name="Nhân viên bơm">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_app" name="Ứng dụng / POS / HĐĐT">
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Vị trí bơm trống, có xe chờ">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataObject id="DataObject_do_plan" />
    <bpmn:dataObjectReference id="do_plan" name="Lịch cₜ theo giờ (A1/A2)" dataObjectRef="DataObject_do_plan" />
    <bpmn:task id="s1" name="Mời xe kế tiếp vào trụ">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="Property_s1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_do_plan_s1">
        <bpmn:sourceRef>do_plan</bpmn:sourceRef>
        <bpmn:targetRef>Property_s1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="s2" name="Quét mã đơn, kiểm tra vòi và loại xăng">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s3" name="Vòi sẵn sàng?">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:outgoing>sf6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s3x" name="Báo khách đổi trụ, hủy đơn">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s3e" name="Không bơm, không trừ tiền">
      <bpmn:incoming>sf5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="s5" name="Bơm đúng số tiền đã trả">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s6" name="Bơm hết số tiền?">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp" name="Bơm, thu tiền như AS-IS">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="m1">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s8" name="Mời xe rời trụ">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s9" name="Vị trí bơm trống lại">
      <bpmn:incoming>sf17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_order" name="Đơn nháp (chưa trừ tiền)" />
    <bpmn:serviceTask id="a2" name="Trừ tiền theo đơn">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="Property_a2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ds_order_a2">
        <bpmn:sourceRef>ds_order</bpmn:sourceRef>
        <bpmn:targetRef>Property_a2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="a3" name="Trừ tiền được?">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:outgoing>sf9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a5" name="Hoàn phần chênh lệch về ứng dụng">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="a6" name="Lập HĐĐT theo số tiền thực bơm, gửi về ứng dụng">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="s0" targetRef="s1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="s1" targetRef="s2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="sf4" name="Không" sourceRef="s3" targetRef="s3x" />
    <bpmn:sequenceFlow id="sf5" sourceRef="s3x" targetRef="s3e" />
    <bpmn:sequenceFlow id="sf6" name="Có" sourceRef="s3" targetRef="a2" />
    <bpmn:sequenceFlow id="sf7" sourceRef="a2" targetRef="a3" />
    <bpmn:sequenceFlow id="sf8" name="Có" sourceRef="a3" targetRef="s5" />
    <bpmn:sequenceFlow id="sf9" name="Không" sourceRef="a3" targetRef="sp" />
    <bpmn:sequenceFlow id="sf10" sourceRef="s5" targetRef="s6" />
    <bpmn:sequenceFlow id="sf11" name="Có" sourceRef="s6" targetRef="m1" />
    <bpmn:sequenceFlow id="sf12" name="Không (bình đầy, vòi dừng)" sourceRef="s6" targetRef="a5" />
    <bpmn:sequenceFlow id="sf13" sourceRef="a5" targetRef="m1" />
    <bpmn:sequenceFlow id="sf14" sourceRef="sp" targetRef="m1" />
    <bpmn:sequenceFlow id="sf15" sourceRef="m1" targetRef="a6" />
    <bpmn:sequenceFlow id="sf16" sourceRef="a6" targetRef="s8" />
    <bpmn:sequenceFlow id="sf17" sourceRef="s8" targetRef="s9" />
    <bpmn:textAnnotation id="t2">
      <bpmn:text>Đổi 2 · bỏ đếm tiền và chờ báo có tại trụ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_t2" associationDirection="None" sourceRef="s5" targetRef="t2" />
    <bpmn:textAnnotation id="t3">
      <bpmn:text>Đổi 3 · HĐĐT gửi về ứng dụng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_t3" associationDirection="None" sourceRef="a6" targetRef="t3" />
    <bpmn:textAnnotation id="t4">
      <bpmn:text>Đổi 4 · số kênh cₜ theo giờ, cửa hàng trưởng công bố trước</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_t4" associationDirection="None" sourceRef="do_plan" targetRef="t4" />
  </bpmn:process>
