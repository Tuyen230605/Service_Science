<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_r1_asis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:collaboration id="Collab_r1_asis">
    <bpmn:participant id="P_cust" name="Khách hàng (xe máy / ô tô)" processRef="Proc_cust" />
    <bpmn:participant id="P_store" name="Cửa hàng xăng dầu (giả định)" processRef="Proc_store" />
    <bpmn:participant id="P_tax" name="Cơ quan thuế (hệ thống hóa đơn điện tử)" />
    <bpmn:messageFlow id="m1" sourceRef="s1" targetRef="c2" />
    <bpmn:messageFlow id="m2" sourceRef="c3" targetRef="s2" />
    <bpmn:messageFlow id="m3" sourceRef="s3x" targetRef="c4a" />
    <bpmn:messageFlow id="m4" sourceRef="s4" targetRef="c4b" />
    <bpmn:messageFlow id="m5" sourceRef="c6" targetRef="s8" />
    <bpmn:messageFlow id="m6" sourceRef="s9" targetRef="c7a" />
    <bpmn:messageFlow id="m7" sourceRef="s15" targetRef="c7b" />
    <bpmn:messageFlow id="m8" name="Dữ liệu HĐĐT" sourceRef="s11" targetRef="P_tax" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_cust" isExecutable="false">
    <bpmn:startEvent id="c0" name="Cần đổ xăng">
      <bpmn:outgoing>cf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="c1" name="Hàng chờ quá dài?">
      <bpmn:incoming>cf1</bpmn:incoming>
      <bpmn:outgoing>cf2</bpmn:outgoing>
      <bpmn:outgoing>cf3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c1e" name="Bỏ đi (balk)">
      <bpmn:incoming>cf2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c2" name="Được mời vào trụ">
      <bpmn:incoming>cf3</bpmn:incoming>
      <bpmn:outgoing>cf4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c3" name="Báo loại xăng, số tiền / số lít">
      <bpmn:incoming>cf4</bpmn:incoming>
      <bpmn:outgoing>cf5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="c4">
      <bpmn:incoming>cf5</bpmn:incoming>
      <bpmn:outgoing>cf6</bpmn:outgoing>
      <bpmn:outgoing>cf8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c4a" name="Được báo không bơm được">
      <bpmn:incoming>cf6</bpmn:incoming>
      <bpmn:outgoing>cf7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c4a" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c4e" name="Rời trụ, chưa được phục vụ">
      <bpmn:incoming>cf7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c4b" name="Nhận số tiền phải trả">
      <bpmn:incoming>cf8</bpmn:incoming>
      <bpmn:outgoing>cf9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c4b" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="c5">
      <bpmn:incoming>cf9</bpmn:incoming>
      <bpmn:incoming>cf13</bpmn:incoming>
      <bpmn:outgoing>cf10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c6" name="Thanh toán (tiền mặt hoặc QR / thẻ)">
      <bpmn:incoming>cf10</bpmn:incoming>
      <bpmn:outgoing>cf11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="c7">
      <bpmn:incoming>cf11</bpmn:incoming>
      <bpmn:outgoing>cf12</bpmn:outgoing>
      <bpmn:outgoing>cf14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c7a" name="Được đề nghị thanh toán lại">
      <bpmn:incoming>cf12</bpmn:incoming>
      <bpmn:outgoing>cf13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c7a" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c7b" name="Được xác nhận đã thanh toán">
      <bpmn:incoming>cf14</bpmn:incoming>
      <bpmn:outgoing>cf15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c7b" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c8" name="Đóng nắp bình, rời trụ">
      <bpmn:incoming>cf15</bpmn:incoming>
      <bpmn:outgoing>cf16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c9" name="Đã đổ xăng">
      <bpmn:incoming>cf16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="cf1" sourceRef="c0" targetRef="c1" />
    <bpmn:sequenceFlow id="cf2" name="Có (≥ 20 xe chờ)" sourceRef="c1" targetRef="c1e" />
    <bpmn:sequenceFlow id="cf3" name="Không" sourceRef="c1" targetRef="c2" />
    <bpmn:sequenceFlow id="cf4" sourceRef="c2" targetRef="c3" />
    <bpmn:sequenceFlow id="cf5" sourceRef="c3" targetRef="c4" />
    <bpmn:sequenceFlow id="cf6" sourceRef="c4" targetRef="c4a" />
    <bpmn:sequenceFlow id="cf7" sourceRef="c4a" targetRef="c4e" />
    <bpmn:sequenceFlow id="cf8" sourceRef="c4" targetRef="c4b" />
    <bpmn:sequenceFlow id="cf9" sourceRef="c4b" targetRef="c5" />
    <bpmn:sequenceFlow id="cf10" sourceRef="c5" targetRef="c6" />
    <bpmn:sequenceFlow id="cf11" sourceRef="c6" targetRef="c7" />
    <bpmn:sequenceFlow id="cf12" sourceRef="c7" targetRef="c7a" />
    <bpmn:sequenceFlow id="cf13" sourceRef="c7a" targetRef="c5" />
    <bpmn:sequenceFlow id="cf14" sourceRef="c7" targetRef="c7b" />
    <bpmn:sequenceFlow id="cf15" sourceRef="c7b" targetRef="c8" />
    <bpmn:sequenceFlow id="cf16" sourceRef="c8" targetRef="c9" />
    <bpmn:textAnnotation id="a_w1">
      <bpmn:text>W1 · chờ đến lượt phục vụ (aᵢ → bᵢ)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_w1" associationDirection="None" sourceRef="c2" targetRef="a_w1" />
    <bpmn:textAnnotation id="a_d">
      <bpmn:text>dᵢ · rời trụ, kết thúc thời gian phục vụ S</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_d" associationDirection="None" sourceRef="c8" targetRef="a_d" />
  </bpmn:process>
  <bpmn:process id="Proc_store" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_store">
      <bpmn:lane id="L_att" name="Nhân viên bơm">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s6m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s7b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s7c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_pos" name="Hệ thống POS / HĐĐT">
        <bpmn:flowNodeRef>s11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s12e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_mgr" name="Cửa hàng trưởng">
        <bpmn:flowNodeRef>s3y</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s12x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s12xe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Vị trí bơm trống, có xe chờ">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataObject id="DataObject_do_sched" />
    <bpmn:dataObjectReference id="do_sched" name="Lịch ca cố định: 6 nhân viên / giờ" dataObjectRef="DataObject_do_sched" />
    <bpmn:task id="s1" name="Mời xe kế tiếp vào trụ">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="Property_s1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_do_sched_s1">
        <bpmn:sourceRef>do_sched</bpmn:sourceRef>
        <bpmn:targetRef>Property_s1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="s2" name="Tiếp nhận yêu cầu (loại xăng, số tiền / số lít)">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s3" name="Vòi sẵn sàng, còn loại xăng?">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s3x" name="Báo khách đổi trụ, báo sự cố">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s4" name="Bơm nhiên liệu, báo số tiền">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="s5">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="s6m">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="s6" name="Hình thức thanh toán?">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s8" name="Nhận tiền mặt, trả tiền thừa">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="s7">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="s7b" name="Nhận báo có (QR / thẻ)">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_s7b" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="s7c" name="Quá thời gian chờ báo có">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_s7c" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="s9" name="Đề nghị khách thanh toán lại">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s10">
      <bpmn:incoming>sf18</bpmn:incoming>
      <bpmn:incoming>sf19</bpmn:incoming>
      <bpmn:outgoing>sf20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s15" name="Xác nhận đã thanh toán, mời xe rời trụ">
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:outgoing>sf27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s16" name="Vị trí bơm trống lại">
      <bpmn:incoming>sf27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s11" name="Tự động lập HĐĐT khi ngắt vòi bơm">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_s11_ds_inv">
        <bpmn:targetRef>ds_inv</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="ds_inv" name="CSDL giao dịch / HĐĐT" />
    <bpmn:exclusiveGateway id="s12" name="Lập HĐĐT thành công?">
      <bpmn:incoming>sf21</bpmn:incoming>
      <bpmn:outgoing>sf22</bpmn:outgoing>
      <bpmn:outgoing>sf23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="s12e" name="HĐĐT đã lập">
      <bpmn:incoming>sf22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="s3y" name="Xử lý sự cố trụ / nguồn hàng">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s3e" name="Sự cố đã chuyển xử lý">
      <bpmn:incoming>sf7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="s12x" name="Ghi nhận giao dịch lỗi, xử lý HĐĐT">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:outgoing>sf24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s12xe" name="Lỗi đã ghi nhận">
      <bpmn:incoming>sf24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf1" sourceRef="s0" targetRef="s1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="s1" targetRef="s2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="sf4" name="Có" sourceRef="s3" targetRef="s4" />
    <bpmn:sequenceFlow id="sf5" name="Không" sourceRef="s3" targetRef="s3x" />
    <bpmn:sequenceFlow id="sf6" sourceRef="s3x" targetRef="s3y" />
    <bpmn:sequenceFlow id="sf7" sourceRef="s3y" targetRef="s3e" />
    <bpmn:sequenceFlow id="sf8" sourceRef="s4" targetRef="s5" />
    <bpmn:sequenceFlow id="sf9" sourceRef="s5" targetRef="s6m" />
    <bpmn:sequenceFlow id="sf10" sourceRef="s5" targetRef="s11" />
    <bpmn:sequenceFlow id="sf11" sourceRef="s6m" targetRef="s6" />
    <bpmn:sequenceFlow id="sf12" name="Tiền mặt" sourceRef="s6" targetRef="s8" />
    <bpmn:sequenceFlow id="sf13" name="QR / thẻ" sourceRef="s6" targetRef="s7" />
    <bpmn:sequenceFlow id="sf14" sourceRef="s7" targetRef="s7b" />
    <bpmn:sequenceFlow id="sf15" sourceRef="s7" targetRef="s7c" />
    <bpmn:sequenceFlow id="sf16" sourceRef="s7c" targetRef="s9" />
    <bpmn:sequenceFlow id="sf17" sourceRef="s9" targetRef="s6m" />
    <bpmn:sequenceFlow id="sf18" sourceRef="s8" targetRef="s10" />
    <bpmn:sequenceFlow id="sf19" sourceRef="s7b" targetRef="s10" />
    <bpmn:sequenceFlow id="sf20" sourceRef="s10" targetRef="s15" />
    <bpmn:sequenceFlow id="sf21" sourceRef="s11" targetRef="s12" />
    <bpmn:sequenceFlow id="sf22" name="Có" sourceRef="s12" targetRef="s12e" />
    <bpmn:sequenceFlow id="sf23" name="Không" sourceRef="s12" targetRef="s12x" />
    <bpmn:sequenceFlow id="sf24" sourceRef="s12x" targetRef="s12xe" />
    <bpmn:sequenceFlow id="sf27" sourceRef="s15" targetRef="s16" />
    <bpmn:textAnnotation id="a_b">
      <bpmn:text>bᵢ · cầm vòi bơm</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_b" associationDirection="None" sourceRef="s4" targetRef="a_b" />
    <bpmn:textAnnotation id="a_b1">
      <bpmn:text>Nút thắt công suất: cₜ cố định, λₜ đổi theo giờ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_b1" associationDirection="None" sourceRef="do_sched" targetRef="a_b1" />
    <bpmn:textAnnotation id="a_h1">
      <bpmn:text>H1 · chuyển giao yêu cầu khách → nhân viên</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_h1" associationDirection="None" sourceRef="s2" targetRef="a_h1" />
    <bpmn:textAnnotation id="a_f2">
      <bpmn:text>F2 · trụ lỗi / hết loại xăng</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_f2" associationDirection="None" sourceRef="s3x" targetRef="a_f2" />
    <bpmn:textAnnotation id="a_w3">
      <bpmn:text>W3 · đếm, trả tiền thừa</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_w3" associationDirection="None" sourceRef="s8" targetRef="a_w3" />
    <bpmn:textAnnotation id="a_w2">
      <bpmn:text>W2 · chờ báo có  ·  F1 · QR / thẻ lỗi</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_w2" associationDirection="None" sourceRef="s7c" targetRef="a_w2" />
    <bpmn:textAnnotation id="a_f3">
      <bpmn:text>F3 · lỗi lập / truyền HĐĐT</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_f3" associationDirection="None" sourceRef="s12" targetRef="a_f3" />
    <bpmn:textAnnotation id="a_h2">
      <bpmn:text>H2 · chuyển cửa hàng trưởng xử lý</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_a_h2" associationDirection="None" sourceRef="s3y" targetRef="a_h2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Defs_r1_asis">
    <bpmndi:BPMNPlane id="BPMNPlane_Defs_r1_asis" bpmnElement="Collab_r1_asis">
      <bpmndi:BPMNShape id="P_cust_di" bpmnElement="P_cust" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1640" height="196" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c0_di" bpmnElement="c0">
        <dc:Bounds x="52" y="110" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="38" y="150" width="64" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c1_di" bpmnElement="c1" isMarkerVisible="true">
        <dc:Bounds x="115" y="103" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="98" y="158" width="84" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c1e_di" bpmnElement="c1e">
        <dc:Bounds x="122" y="32" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="42" y="42" width="76" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
